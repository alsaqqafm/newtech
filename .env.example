# ===================================================
# NEWTECH MEDICAL - Environment Variables Template
# Copy this file to .env and adjust values for your environment
# NEVER commit the actual .env file with real secrets!
# ===================================================

# Application Environment (production / development)
NODE_ENV=production

# Server Port (Render, Railway, and VPS inject this automatically)
PORT=3000

# JSON Web Token Secret Key (Replace with a strong random string in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars

# Database Storage Path (Optional: defaults to database/newtechmed.db)
# On cloud platforms with persistent volume, set to your volume path (e.g. /var/data/database/newtechmed.db)
DATABASE_PATH=database/newtechmed.db

# Cloudinary Permanent Image Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Automated In-Service Backup Encryption Key (AES-256-GCM)
BACKUP_ENCRYPTION_KEY=replace_with_a_secure_encryption_key_for_backups

# Vercel Reverse Proxy Target (Optional: set on Vercel to route /api/* to Render)
# BACKEND_API_URL=https://newtechmed-server.onrender.com
